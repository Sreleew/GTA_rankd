app:
  name: gta-ranked-studio
  version: 0.8.3

hardware:
  gpu_model: AMD Radeon RX 9060 XT
  gpu_architecture: gfx1200
  gpu_vram_gb: 16

paths:
  inbox_shorts: inbox/shorts
  output_shorts: out/shorts
  database: data/clip_bank.sqlite
  logs: logs
  temp: work/tmp
  fonts: assets/fonts
  prompts: prompts
  models: models/whisper
  tools: tools

executables:
  ffmpeg: ffmpeg
  ffprobe: ffprobe
  whisper_cli: tools/whisper.cpp/whisper-cli.exe

encoding:
  width_short: 1080
  height_short: 1920
  fps: match_source
  video_codec: h264_amf
  fallback_video_codec: libx264
  audio_codec: aac
  short_loudness_lufs: -14
  amf_bitrate: 12M

transcription:
  engine: whisper.cpp
  backend: vulkan
  model_path: models/whisper/ggml-large-v3-turbo.bin
  language: en
  threads: 0
  vad_model_path: models/whisper/ggml-silero-v6.2.0.bin
  temperature: 0.0

ollama:
  base_url: http://127.0.0.1:11434
  model: qwen2.5:7b-instruct
  temperature: 0.4
  request_timeout_seconds: 180
  retries: 2

branding:
  handle: '@GTARankedStudio'
  font_name: Arial
  font_file: assets/fonts/Anton-Regular.ttf

shorts:
  max_input_duration_seconds: 165
  layout: smart
  default_crop_x: 80
  dynamic_zoom: true
  zoom_percent: 8
  captions_enabled: true
  peak_trim_threshold_seconds: 165
  peak_lead_seconds: 1.5
  payoff_tail_seconds: 2.0
  auto_trim_enabled: true
  auto_trim_min_seconds: 60
  auto_trim_max_seconds: 165
  sfx_enabled: true
  sfx_volume: 0.14

logging:
  level: INFO
  max_bytes: 5242880
  backup_count: 3

web:
  host: 127.0.0.1
  port: 8765
  max_upload_mb: 2048
